# ---- Meta (Facebook + Instagram) ----
# Long-lived PAGE access token (not a user token)
META_PAGE_ACCESS_TOKEN=your_long_lived_page_token
FACEBOOK_PAGE_ID=123456789012345
# Instagram Business/Creator account ID linked to the Page above
INSTAGRAM_USER_ID=17841400000000000
GRAPH_API_VERSION=v23.0

# ---- Public media hosting (needed for Instagram only) ----
# Instagram's API fetches media from a public URL, so pick ONE option:
# Option A: Cloudinary (free tier works) - copy "API Environment variable" from your Cloudinary dashboard
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B: your own server/CDN that serves the ./media folder publicly
# PUBLIC_MEDIA_BASE_URL=https://yourdomain.com/media

# ---- App ----
TIMEZONE=Asia/Kolkata
SCHEDULER_POLL_SECONDS=30
DB_PATH=scheduler.db
